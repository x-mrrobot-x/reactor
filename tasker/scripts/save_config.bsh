import org.json.JSONObject;
import java.io.File;
import java.io.FileWriter;
import com.joaomgcd.taskerm.action.java.JavaCodeException;

try {
    JSONObject payload = new JSONObject(tasker.getVariable("config"));
    if (!payload.has("config")) throw new JavaCodeException("Config ausente no payload.");
    JSONObject cfgRoot = payload.getJSONObject("config");

    Object rawCfg = tasker.getJavaVariable("reactorConfig");
    if (rawCfg != null && rawCfg != void) {
        JSONObject currentCfg = (JSONObject) rawCfg;
        if (currentCfg.has("stats")) {
            cfgRoot.put("stats", currentCfg.getJSONObject("stats"));
        }
    }

    File file = new File(CONFIG_PATH);
    file.getParentFile().mkdirs();
    FileWriter writer = null;
    try {
        writer = new FileWriter(file, false);
        writer.write(cfgRoot.toString(2));
    } finally {
        if (writer != null) writer.close();
    }

    tasker.setJavaVariable("reactorConfig", cfgRoot);

    Object reactorObj = tasker.getJavaVariable("reactorInstance");
    boolean monitorActive = (reactorObj != null && reactorObj != void);
    long monitorStartedAt = 0;
    if (monitorActive) {
        Object reactor = (Object) reactorObj;
        monitorStartedAt = reactor.monitorStartedAt;

        reactor.config = cfgRoot;
        reactor.invalidateCache();
    }

    JSONObject result = new JSONObject();
    result.put("ok", true);
    result.put("monitorActive", monitorActive);
    result.put("monitorStartedAt", monitorStartedAt > 0 ? monitorStartedAt : JSONObject.NULL);
    result.put("message", "Configuração salva");
    return result.toString();
} catch (Throwable e) {
    JSONObject err = new JSONObject();
    err.put("ok", false);
    err.put("error", "Erro ao salvar configuração: " + e.toString());
    return err.toString();
}
