import org.json.JSONObject;
import java.io.File;
import java.io.FileReader;

JSONObject cfgRoot;
Object rawCfg = tasker.getJavaVariable("reactorConfig");
if (rawCfg != null && rawCfg != void) {
    cfgRoot = (JSONObject) rawCfg;
} else {
    File file = new File(CONFIG_PATH);
    if (file.exists()) {
        FileReader reader = null;
        try {
            reader = new FileReader(file);
            char[] buf = new char[(int) file.length()];
            reader.read(buf);
            cfgRoot = new JSONObject(new String(buf));
            tasker.setJavaVariable("reactorConfig", cfgRoot);
        } finally {
            if (reader != null) reader.close();
        }
    } else {
        cfgRoot = null;
    }
}

Object monStatus = tasker.getJavaVariable("stopReactorMonitor");
boolean monitorActive = (monStatus != null && monStatus != void);

JSONObject result = new JSONObject();
result.put("ok", true);
result.put("monitorActive", monitorActive);
result.put("config", cfgRoot != null ? cfgRoot : JSONObject.NULL);
return result.toString();
